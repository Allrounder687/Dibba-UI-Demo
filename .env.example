# PostgreSQL Connection String (Optional in local dev; required for production DB)
DATABASE_URL=postgresql://dibba_scc:change_me_in_production@localhost:5432/dibba_scc_db

# JWT Session Signing Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-32-byte-random-secret

# Initial Administrator Account (Used for CMS Auth & DB Seeding)
ADMIN_INITIAL_EMAIL=admin@dibbaclub.ae
ADMIN_INITIAL_PASSWORD=replace-with-strong-password

# Optional Cloud Media Storage & Auto-Cutout (falls back to local public/uploads/)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=club-media
REMOVE_BG_API_KEY=

# Optional Automated Fixture Sync (/api/cron/sync-matches)
API_FOOTBALL_KEY=
API_FOOTBALL_TEAM_ID=
API_FOOTBALL_SEASON=2026
CRON_SECRET=replace-with-cron-bearer-secret
